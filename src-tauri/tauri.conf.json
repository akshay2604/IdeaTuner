{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri/refs/heads/dev/crates/tauri-utils/schema.json",
  "productName": "IdeaTuner",
  "version": "0.2.0",
  "identifier": "com.ideatuner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "IdeaTuner",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
